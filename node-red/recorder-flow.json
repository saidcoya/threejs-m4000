[
  {
    "id": "recorder_tab",
    "type": "tab",
    "label": "M4000 Recorder",
    "disabled": false,
    "info": "Endpoint POST para recibir muestras del registrador y GET para snapshot"
  },
  {
    "id": "post_in",
    "type": "http in",
    "z": "recorder_tab",
    "name": "POST /api/m4000/recorder/samples",
    "url": "/api/m4000/recorder/samples",
    "method": "post",
    "upload": false,
    "swaggerDoc": "",
    "x": 170,
    "y": 120,
    "wires": [["post_store"]]
  },
  {
    "id": "post_store",
    "type": "function",
    "z": "recorder_tab",
    "name": "guardar última muestra",
    "func": "const sample = msg.payload || {};\nglobal.set('recorderLast', sample);\nmsg.statusCode = 204;\nmsg.payload = '';\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 120,
    "wires": [["post_resp"]]
  },
  {
    "id": "post_resp",
    "type": "http response",
    "z": "recorder_tab",
    "name": "",
    "statusCode": "204",
    "headers": {},
    "x": 670,
    "y": 120,
    "wires": []
  },
  {
    "id": "get_in",
    "type": "http in",
    "z": "recorder_tab",
    "name": "GET /api/m4000/recorder/samples",
    "url": "/api/m4000/recorder/samples",
    "method": "get",
    "upload": false,
    "swaggerDoc": "",
    "x": 170,
    "y": 240,
    "wires": [["get_snapshot"]]
  },
  {
    "id": "get_snapshot",
    "type": "function",
    "z": "recorder_tab",
    "name": "devolver snapshot",
    "func": "const last = global.get('recorderLast');\nif (!last) {\n  msg.statusCode = 200;\n  msg.payload = { timestamp: null, source: null, simulated: true, enabledChannels: 0, channels: [] };\n  return msg;\n}\nmsg.statusCode = 200;\nmsg.payload = last;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 240,
    "wires": [["get_resp"]]
  },
  {
    "id": "get_resp",
